{
  "expo": {
    "name": "آپاراتچی",
    "slug": "aparatchi-mobile",
    "scheme": "aparatchi",
    "version": "0.16.14",
    "orientation": "default",
    "icon": "./assets/aparatchi-icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07090c",
    "splash": {
      "image": "./assets/splash-cinema-1080x2400.png",
      "resizeMode": "cover",
      "backgroundColor": "#07090c"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aparatchi.mobile"
    },
    "android": {
      "package": "com.aparatchi.mobile",
      "icon": "./assets/aparatchi-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/aparatchi-adaptive-foreground.png",
        "backgroundColor": "#07090c"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 44,
      "permissions": [
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-video",
        {
          "supportsPictureInPicture": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#D6A84B",
          "defaultChannel": "episode-updates"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/aparatchi-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#07090c",
          "dark": {
            "image": "./assets/aparatchi-icon.png",
            "backgroundColor": "#07090c"
          }
        }
      ],
      "expo-web-browser"
    ]
  }
}
